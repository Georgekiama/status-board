# ---------------------------------------------------------------------------
# Status Board environment
# Copy to .env for local development. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# Postgres connection string. In production this is the Neon pooled URL.
# Neon:     postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Local pg: postgresql://postgres:postgres@localhost:5432/statusboard
# Local dev/test with no server at all (real Postgres via WASM):
#           pglite://.pglite/statusboard
DATABASE_URL=

# Comma-separated list of browser origins allowed to call the API.
# Leave empty when the frontend is served from the same origin as the API
# (the recommended deployment — no CORS needed at all).
# Example: https://status.litnmore.com,https://statusboard.vercel.app
ALLOWED_ORIGINS=

# Optional shared secret. When set, every /api/board and /api/mcp request must
# send `Authorization: Bearer <token>` (or `X-Api-Token: <token>`).
# Leave empty to disable (v1 default — see "Known limitations" in README).
API_TOKEN=

# Local dev server port (not used on Vercel).
PORT=3000

# Shared password for the OAuth sign-in page at /oauth/authorize. Required for
# Claude/Cowork custom connectors: without it, authorization cannot be granted
# and /oauth/authorize returns 503. There are no user accounts -- this one
# password is what stops anybody who knows the URL from minting themselves a
# token. Choose something long.
BOARD_PASSWORD=

# Override the public base URL used in OAuth metadata. Normally derived from the
# request, so leave this empty unless the deployment sits behind a proxy that
# rewrites the Host header.
PUBLIC_BASE_URL=
